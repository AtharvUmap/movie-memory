# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://movie:movie@localhost:5432/movie_memory?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Trust the request Host header. Needed for `next start` locally; in a real
# deployment set AUTH_URL to the public URL instead (Vercel sets this for you).
AUTH_TRUST_HOST=true

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional: any OpenAI-compatible server, e.g. a local Ollama (see README)
# OPENAI_BASE_URL="http://localhost:11434/v1"
